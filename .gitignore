# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.ruff_cache/

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OpenClaw runtime
.openclaw/
bak/

# Sensitive data (never commit)
memory/alerts.txt
*.nmap
pentest_learning_results/
penetration/

# Logs
*.log
!validation/evidence/*.log

# v0.1.45.1 CyberGym calibration - exclude heavy task artifacts
validation/evidence/cybergym/v0.1.45/traces/*.task/
validation/evidence/cybergym/v0.1.45/**/*.tar.gz
validation/evidence/cybergym/v0.1.45/**/_extracted/

# kali-claw agent stray work files (created in cwd during claude --print)
work_*
_p[0-9]*
_pctest*

# Claude Code scheduled tasks lock
.claude/scheduled_tasks.lock

# Phase 1 cleanup: prevent evidence files from re-entering repo
# (CyberGym evaluation tarballs can be 100s of MB each)
validation/evidence/cybergym/**/repo-vul.tar.gz
validation/evidence/cybergym/**/src-vul/
validation/evidence/cybergym/**/*extracted/
